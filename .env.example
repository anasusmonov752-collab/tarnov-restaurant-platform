# Bu — NAMUNA fayl (gitga tushadi, maxfiy qiymat yozilmaydi).
# Ishlatish: shu fayldan `.env` nusxasini oling va qiymatlarni to'ldiring.
#   cp .env.example .env

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://FOYDALANUVCHI:PAROL@cluster0.xxxxx.mongodb.net/tarnov?appName=Cluster0

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=tasodifiy-uzun-maxfiy-satr

# ── AI ────────────────────────────────────────────────────────
# gemini (default, bepul) | anthropic
AI_PROVIDER=gemini

# Google AI Studio → https://aistudio.google.com/apikey
# MUHIM: billing YOQILMAGAN loyihada yarating, aks holda bepul tarif o'chadi.
GEMINI_API_KEY=

# Ixtiyoriy — Gemini kvotasi tugaganda zaxira sifatida ishlatiladi.
ANTHROPIC_API_KEY=

# ── Telegram bot ──────────────────────────────────────────────
# BITTA platforma boti (@TalentHubUzBot) barcha mijoz restoranlarga
# xizmat qiladi. Token bazaga YOZILMAYDI va API javoblarida chiqmaydi —
# faqat shu yerda (Render dashboard'ida) turadi.
#
# BotFather -> /newbot -> token. Token sizib chiqsa: /revoke
TELEGRAM_BOT_TOKEN=

# Webhook sirini O'ZINGIZ o'ylab topasiz — uzun tasodifiy satr.
# Telegram uni har so'rovda X-Telegram-Bot-Api-Secret-Token sarlavhasida
# qaytaradi; server shu orqali so'rov haqiqatan Telegram'dan kelganini biladi.
TELEGRAM_WEBHOOK_SECRET=

# Ixtiyoriy — berilmasa getMe orqali avtomatik aniqlanadi
TELEGRAM_BOT_USERNAME=

# APP_URL — webhook manzilini qurish uchun ilovaning tashqi manzili.
# Bo'sh qoldirilsa so'rov sarlavhalaridan aniqlanadi (Render'da shunday ishlaydi).
APP_URL=

# ── SMS (Eskiz.uz) ────────────────────────────────────────────
# Nomzodga Telegram havolasini yuborish uchun. Bo'sh bo'lsa SMS kanali
# o'chiq bo'ladi va havola "qo'lda" rejimida qaytariladi (hh chati/email
# orqali o'zingiz uzatasiz) — bot bundan ham to'liq ishlaydi.
# Kalitlar: my.eskiz.uz -> SMS -> "СМС шлюз" bo'limida.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi. 4546 — Eskiz'ning umumiy raqami, bepul.
# Brendlangan alfa-nom operatorlarga oyiga ~550 ming so'm turadi.
SMS_FROM=4546

# ── Lokal dev ─────────────────────────────────────────────────
# Tizim DNS'i Atlas SRV'ni topa olmasa
DNS_OVERRIDE=8.8.8.8,1.1.1.1
